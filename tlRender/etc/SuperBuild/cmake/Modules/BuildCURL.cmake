include(ExternalProject)

if (USE_SYSTEM_LIBS)
    find_package(CURL CONFIG)
    if (NOT CURL_FOUND)
	find_package(curl)
    endif()
    set(CURL_DEP )
endif()

if (NOT curl_FOUND AND NOT CURL_FOUND)
    set(CURL_GIT_REPOSITORY "https://github.com/curl/curl.git")
    set(CURL_GIT_TAG "curl-8_4_0")

    set(CURL_UNIX_ARGS )
    if (UNIX)
	set(CURL_UNIX_ARGS
	    -DOPENSSL_INCLUDE_DIR=${CMAKE_INSTALL_PREFIX}/include
	    -DLIBSSH2_INCLUDE_DIR=${CMAKE_INSTALL_PREFIX}/include)

	if (REDHAT_DISTRO)
	    list(APPEND CURL_UNIX_ARGS
		-DOPENSSL_LIBRARY=${CMAKE_INSTALL_PREFIX}/lib64/libssl.a
		-DLIBSSH2_LIBRARY=${CMAKE_INSTALL_PREFIX}/lib64/libssh2.a)
	else()  # APPLE OR DEBIAN_DISTRO
	    list(APPEND CURL_UNIX_ARGS
		-DOPENSSL_LIBRARY=${CMAKE_INSTALL_PREFIX}/lib/libssl.a
		-DLIBSSH2_LIBRARY=${CMAKE_INSTALL_PREFIX}/lib/libssh2.a)
	endif()
    endif()
    
    set(CURL_ARGS
	-DBUILD_CURL_EXE=OFF
	-DBUILD_EXAMPLES=OFF
	-DBUILD_LIBCURL_DOCS=OFF
	-DBUILD_MISC_DOCS=OFF
	-DBUILD_TESTING=OFF
	-DCURL_USE_OPENSSL=ON
	-DCURL_USE_LIBSSH2=ON
	-DCURL_USE_LIBPSL=OFF
	-DCURL_DISABLE_LDAP=ON
	${CURL_UNIX_ARGS}
	${TLRENDER_EXTERNAL_ARGS})

    set(CURL_DEPENDENCIES ${Libssh2_DEP} ${OpenSSL_DEP} ${ZLIB_DEP})
    message(STATUS "CURL DEPENDENCIES=${CURL_DEPENDENCIES}")

    ExternalProject_Add(
	CURL
	PREFIX ${CMAKE_CURRENT_BINARY_DIR}/../../../deps/CURL
	DEPENDS ${CURL_DEPENDENCIES}
	GIT_REPOSITORY ${CURL_GIT_REPOSITORY}
	GIT_TAG ${CURL_GIT_TAG}
	LIST_SEPARATOR |
	CMAKE_ARGS ${CURL_ARGS})

    set(CURL_DEP CURL)
endif()
