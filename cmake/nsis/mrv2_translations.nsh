; -*- coding: utf-8 -*-
; Translations for the mrv2 NSIS installer (file association page + every
; string that used to be hard-coded English in NSIS.template.in).
;
; This file is included from NSIS.template.in (after the MUI_LANGUAGE lines)
; and from fileext.nsh.  The guard below makes the second include a no-op.
;
; MUST be saved as UTF-8 *with BOM*, otherwise NSIS reads it as ANSI.

!ifndef MRV2_TRANSLATIONS_INCLUDED
!define MRV2_TRANSLATIONS_INCLUDED

!ifndef MRV2_NAME
  !define MRV2_NAME "mrv2"
!endif

; ---------------------------------------------------------------
; File association page
; ---------------------------------------------------------------

