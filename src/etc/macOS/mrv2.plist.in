<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleExecutable</key>
    <string>@INSTALL_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>com.@INSTALL_NAME@.@INSTALL_NAME@</string>
    <key>CFBundleName</key>
    <string>@INSTALL_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>@INSTALL_NAME@</string>
    <key>CFBundleIconFile</key>
    <string>@INSTALL_NAME@.icns</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@mrv2_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@mrv2_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.00</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2022-Present Contributors to the mrv2 project.</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.mrv2.mrv2.session</string>
            <key>UTTypeDescription</key>
            <string>mrv2 Session File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mrv2s</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.ilm.openexr-image</string>
            <key>UTTypeDescription</key>
            <string>OpenEXR Image</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.image</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>exr</string>
                    <string>sxr</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.mrv2.dpx-image</string>
            <key>UTTypeDescription</key>
            <string>DPX Image</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.image</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>dpx</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.mrv2.otio</string>
            <key>UTTypeDescription</key>
            <string>OpenTimelineIO File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>otio</string>
                    <string>otioz</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>RAW and Layered Images</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.camera-raw-image</string>
                <string>com.adobe.digital-negative</string>
                <string>com.adobe.photoshop-image</string>
            </array>
        </dict>

        <dict>
            <key>CFBundleTypeName</key>
            <string>Image Files</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.ilm.openexr-image</string>
                <string>com.mrv2.dpx-image</string>
                <string>public.jpeg</string>
                <string>public.png</string>
                <string>public.tiff</string>
                <string>com.truevision.tga-image</string>
                <string>com.microsoft.bmp</string>
                <string>com.sgi.sgi-image</string>
            </array>
        </dict>

        <dict>
            <key>CFBundleTypeName</key>
            <string>Movie Files</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.movie</string>
                <string>public.video</string>
                <string>public.mpeg-4</string>
                <string>com.apple.quicktime-movie</string>
                <string>public.avi</string>
                <string>public.mpeg</string>
            </array>
        </dict>

        <dict>
            <key>CFBundleTypeName</key>
            <string>OpenTimelineIO Files</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.mrv2.otio</string>
            </array>
        </dict>

        <dict>
            <key>CFBundleTypeName</key>
            <string>mrv2 Session File</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.mrv2.mrv2.session</string>
            </array>
        </dict>
    </array>

    <key>NSCameraUsageDescription</key>
    <string>This application requires camera access for WebRTC video streaming.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>This application requires microphone access for WebRTC audio streaming.</string>
</dict>
</plist>
